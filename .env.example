# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL, via Prisma) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- JWT Auth (access token ngan han + refresh token co rotate) ---
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Password hashing ---
BCRYPT_SALT_ROUNDS="12"

# --- Cloudinary (upload anh bia/avatar) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- AniList GraphQL API (du lieu manga/LN trending) ---
# Public endpoint, khong can API key: https://graphql.anilist.co
ANILIST_API_URL="https://graphql.anilist.co"

# --- Rate limiting (login theo IP/email - Security_Cases Case 2) ---
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_ATTEMPTS="5"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
